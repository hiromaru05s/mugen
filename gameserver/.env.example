# gameserver/.env — VM上の設定(このファイルをコピーして .env を作る)
# 秘密が入るのでgitにはコミットしないこと(.gitignore済み)

# 証明書を取るドメイン。VMのグローバルIPをAレコードで指しておく
GS_DOMAIN=gs.example.com
ACME_EMAIL=you@example.com

# Cloudflare Workers側のURL(戦績DB・静的配信はこちらに残る)
WORKERS_ORIGIN=https://mugen-no-mori.maruru836818.workers.dev

# Workers の /api/gs/* を叩くための共有秘密。次のコマンドで作った値を
#   openssl rand -hex 32
# ここと、Workers側の両方に同じ値を入れる:
#   cd workers && npx wrangler secret put GAME_SERVER_SECRET
GAME_SERVER_SECRET=

# ログインを使う場合のみ(Workers側と同じ公開キー)。空ならゲストのみ
CLERK_PUBLISHABLE_KEY=

# --- 上限(通常は変更不要。接続の殺到でVMを落とさないための防波堤) ---
# MAX_ROOMS=40           同時ルーム数(40 = 240人)
# MAX_CONNS=300          同時接続の総数
# MAX_CONNS_PER_IP=6     同一IPからの同時接続
# JOIN_BURST=12          同一IPの10秒あたりの接続試行
