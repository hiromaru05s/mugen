# 夢幻の森 — TLS終端 + WebSocketリバースプロキシ
# ブラウザはHTTPSページから ws:// に繋げない(mixed content)ため wss:// が必須。
# Caddyがドメインに対してLet's Encrypt証明書を自動取得・自動更新する。
{
	# 証明書の期限通知先。取得に失敗した時の連絡が来るので入れておくとよい
	email {$ACME_EMAIL:admin@example.com}
}

{$GS_DOMAIN} {
	encode zstd gzip

	# ヘルスチェックは誰でも叩ける(監視・デプロイスクリプト用)
	handle /health {
		reverse_proxy game:8080
	}

	# 試合のWebSocketと復帰確認。Caddyはws/wssのUpgradeを自動で通す
	handle {
		reverse_proxy game:8080 {
			# 20Hzで通信し続けるので、アイドル切断されないよう長めに取る
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}
}
